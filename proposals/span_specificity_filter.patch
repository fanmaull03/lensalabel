+"""Candidate-level span specificity filter for overlapping ingredient names."""
+from __future__ import annotations
+from collections.abc import Iterable
+
+def filter_contained_candidates(candidates: Iterable[tuple], threshold: float) -> list[tuple]:
+    rows = list(candidates)
+    kept = []
+    for candidate in rows:
+        score, _window, start, end, entry_index, *_ = candidate
+        contained = any(
+            other is not candidate
+            and other[0] >= threshold
+            and other[4] != entry_index
+            and other[2] <= start and end <= other[3]
+            and (other[2], other[3]) != (start, end)
+            for other in rows
+        )
+        if not contained:
+            kept.append(candidate)
+    return kept
