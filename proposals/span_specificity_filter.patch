diff --git a/evaluation/tests/test_span_specificity_proposal.py b/evaluation/tests/test_span_specificity_proposal.py
new file mode 100644
--- /dev/null
+++ b/evaluation/tests/test_span_specificity_proposal.py
@@ -0,0 +1,23 @@
+from pathlib import Path
+import sys
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "backend"))
+from app.matching.span_specificity import filter_contained_candidates
+
+def candidate(score, start, end, entry_index, window):
+    return (score, window, start, end, entry_index, "window", None)
+
+def test_nested_generic_span_is_removed_when_specific_candidate_qualifies():
+    generic = candidate(100, 0, 4, 1, "Susu")
+    specific = candidate(100, 0, 15, 2, "Susu Skim Bubuk")
+    assert filter_contained_candidates([generic, specific], 75) == [specific]
+
+def test_noncontained_candidates_remain():
+    left = candidate(100, 0, 7, 1, "Bahan A")
+    right = candidate(100, 8, 15, 2, "Bahan B")
+    assert filter_contained_candidates([left, right], 75) == [left, right]
+
+def test_below_threshold_container_does_not_suppress():
+    generic = candidate(100, 0, 4, 1, "Susu")
+    specific = candidate(70, 0, 15, 2, "Susu Skim Bubuk")
+    assert filter_contained_candidates([generic, specific], 75) == [generic, specific]
