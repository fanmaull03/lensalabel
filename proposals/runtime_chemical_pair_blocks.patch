diff --git a/backend/app/matching/pair_blocks.py b/backend/app/matching/pair_blocks.py
new file mode 100644
--- /dev/null
+++ b/backend/app/matching/pair_blocks.py
@@ -0,0 +1,23 @@
+"""Shared chemical-identity exceptions for annotation and runtime matching."""
+from __future__ import annotations
+import json
+import re
+from functools import lru_cache
+from pathlib import Path
+
+_DATA = Path(__file__).with_name("chemical_pair_blocks.json")
+
+@lru_cache(maxsize=1)
+def pair_data() -> dict:
+    return json.loads(_DATA.read_text(encoding="utf-8"))
+
+def _words(text: str) -> set[str]:
+    return {word.casefold() for word in re.findall(r"\w+", text, re.UNICODE)}
+
+def is_forbidden_pair(observed: str, variant: str) -> bool:
+    left, right = _words(observed), _words(variant)
+    groups = pair_data()
+    for a, b in groups["active_pairs"] + groups["expert_distinct_pairs"]:
+        if (a in left and b in right) or (b in left and a in right):
+            return True
+    return False
diff --git a/evaluation/tests/test_runtime_chemical_pair_blocks.py b/evaluation/tests/test_runtime_chemical_pair_blocks.py
new file mode 100644
--- /dev/null
+++ b/evaluation/tests/test_runtime_chemical_pair_blocks.py
@@ -0,0 +1,27 @@
+from pathlib import Path
+import sys
+ROOT = Path(__file__).resolve().parents[2]
+sys.path[:0] = [str(ROOT / "backend"), str(ROOT)]
+from app.matching.pair_blocks import is_forbidden_pair, pair_data
+from evaluation.calibration_annotations import is_word_fuzzy_match
+from app.matching.fuzzy_matcher import match_token_many
+
+def test_shared_active_pairs_are_visible_to_helper_and_runtime():
+    assert len(pair_data()["active_pairs"]) == 13
+    for left, right in pair_data()["active_pairs"]:
+        assert not is_word_fuzzy_match(left, right)
+        assert is_forbidden_pair(left, right)
+
+def test_expert_distinct_families_are_protected():
+    assert len(pair_data()["expert_distinct_pairs"]) == 14
+    for left, right in pair_data()["expert_distinct_pairs"]:
+        assert is_forbidden_pair(left, right)
+
+def test_ordinary_one_character_typo_remains_allowed():
+    assert is_word_fuzzy_match("susuu", "susu")
+
+def test_runtime_matcher_rejects_kalium_kalsium_identity_collision():
+    kb = [{"ingredient_id": 1, "standard_name": "Kalsium karbonat",
+           "category": "hindari", "name_variant": "Kalsium karbonat"}]
+    matches = match_token_many("Kalium Karbonat", kb, threshold=90)
+    assert not any(match.matched for match in matches)
